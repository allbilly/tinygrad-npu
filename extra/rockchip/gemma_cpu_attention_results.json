  "runner_source": "\"\"\"CPU-only Gemma attention comparison; no whole-model speed claim.\"\"\"\nimport hashlib,json,statistics,time\nfrom pathlib import Path\nimport numpy as np\nfrom tinygrad import Tensor,TinyJit,dtypes\nfrom tinygrad.llm.kernels.rockchip_cpu import prefill_attention\n\nM=Path(__file__).resolve().parent\nreport={'complete':False,'scope':'CPU-only unit-scale attention; each fixture has three warmups then 20 ABBA/BAAB blocks.',\n        'source_sha256':hashlib.sha256(Path('/home/orangepi/tinygrad/tinygrad/llm/kernels/rockchip_cpu.py').read_bytes()).hexdigest(),\n        'cases':[]}\nrng=np.random.default_rng(301026)\nfor rows,dim,window in [(1,256,0),(1,512,0),(128,256,0),(128,512,0),(17,512,64)]:\n heads,kv_heads,context,end=8,1,512,511\n query=rng.normal(0,.1,(1,heads,rows,dim)).astype(np.float32)\n cache=rng.normal(0,.1,(2,1,kv_heads,context,dim)).astype(np.float16)\n q,kv=Tensor(query,device='CPU').realize(),Tensor(cache,device='CPU').realize()\n def generic(q,kv):\n  key,val=(x[:,:,:end].repeat_interleave(heads//kv_heads,dim=1) for x in (kv[0],kv[1]))\n  positions=Tensor.arange(rows).to('CPU')+end-rows\n  keys=Tensor.arange(end).to('CPU')\n  allowed=keys.unsqueeze(0)<=positions.unsqueeze(1)\n  if window:allowed=allowed&(keys.unsqueeze(0)>positions.unsqueeze(1)-window)\n  scores=q.matmul(key.transpose(-1,-2),dtype=dtypes.float32)+allowed.where(0,float('-inf'))\n  return scores.softmax(-1).matmul(val,dtype=dtypes.float32).realize()\n runs={'control':TinyJit(generic),'candidate':TinyJit(lambda q,kv:prefill_attention(q,kv,end,score_scale=1.0,window=window).realize())}\n for _ in range(3):\n  for run in runs.values():run(q,kv)\n expected=runs['control'](q,kv).numpy().copy();actual=runs['candidate'](q,kv).numpy().copy()\n np.testing.assert_allclose(actual,expected,atol=2e-5,rtol=3e-4)\n case={'rows':rows,'dim':dim,'window':window,'heads':heads,'kv_heads':kv_heads,'context':context,'end':end,\n       'max_abs_error':float(np.abs(actual-expected).max()),'times_ns':{k:[] for k in runs}}\n for block in range(20):\n  for label in (('control','candidate','candidate','control') if block%2==0 else ('candidate','control','control','candidate')):\n   start=time.perf_counter_ns();runs[label](q,kv);case['times_ns'][label].append(time.perf_counter_ns()-start)\n a,b=case['times_ns']['control'],case['times_ns']['candidate']\n ratios=[statistics.mean(a[i:i+2])/statistics.mean(b[i:i+2]) for i in range(0,len(a),2)]\n case['paired_speedup_median']=statistics.median(ratios);case['paired_blocks_faster']=sum(v>1 for v in ratios)\n case['median_ms']={k:statistics.median(v)/1e6 for k,v in case['times_ns'].items()}\n report['cases'].append(case);(M/'cpu-gemma-attention-primitive-v1.json').write_text(json.dumps(report,indent=2)+'\\n')\n print(json.dumps({k:v for k,v in case.items() if k!='times_ns'}),flush=True)\nreport['complete']=True\n(M/'cpu-gemma-attention-primitive-v1.json').write_text(json.dumps(report,indent=2)+'\\n')\n",
